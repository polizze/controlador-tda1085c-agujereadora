TEXT 144 1520 Left 2 !.meas TRAN Vcc_avg AVG V(VCC_PIN9)\n.meas TRAN Vcc_pp PP V(VCC_PIN9)\n.meas TRAN P_Rdrop1_W AVG (V(N_RECT)-V(N_DROP_MID))*I(D1)\n.meas TRAN I_gate_pk_mA MAX -I(R_GATE_150R)*1000\n.meas TRAN P_Rgate_mW AVG (V(PIN13_TRIG)-V(GATE_BTB12))*-I(R_GATE_150R)*1000\n.meas TRAN Vset_max_100pct AVG V(N_POT_TOP)\n.meas TRAN Vset_min_0pct AVG V(PIN5_VSET_MAX)\n.meas TRAN Vpin4_470p_2500rpm AVG V(PIN4_470P_2500)\n.meas TRAN Vpin4_1n_2500rpm AVG V(PIN4_1N_2500)\n.meas TRAN I_motor_rms RMS I(L_ROTOR_P2_P6)\n.meas TRAN P_motor_W AVG (V(PIN5_ESTATOR_NEGRO)-V(PIN6_ROTOR_AZUL_MT2))*I(L_ROTOR_P2_P6)\n.meas TRAN P_BTB12_W AVG V(PIN6_ROTOR_AZUL_MT2)*(I(B_BTB12_POS)+I(B_BTB12_NEG))\n.meas TRAN P_Snubber_W AVG (V(PIN6_ROTOR_AZUL_MT2)-V(N_SNUB))*I(R_SNUB_100R_1W)
TEXT 160 112 Left 2 ;BLOQUE 1: FUENTE (2x 4.7k 3W + C_VCC=220uF/25V) + PRESET 50k EN SERIE CON POT 10k + DISPARO GATE R_G=150R (1W) -> BTB12-600BW (I_GT=50mA)
TEXT 160 576 Left 2 ;BLOQUE 2: TACOMETRO MEDIDO (Pines 3-4 Rojos: R_tacho=73.0R, 8 Polos, 166.6Hz @ 2500 RPM) + FILTRO 10k/10nF + BOMBA DE CARGA C11=470pF vs 1nF
TEXT 160 976 Left 2 ;BLOQUE 3: MOTOR C.E.SET. MCA 52/64 SERIE: Pin 5 (Negro) -> Estator (2.1R+15mH) -> Puente Pin 1 (Gris) a Pin 2 (Violeta) -> Rotor (6.5R+13mH+FEM) -> Pin 6 (Azul, MT2)
